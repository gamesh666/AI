###############################################################################
# AI VMS Platform — environment variables
#
#   cp .env.example .env        then replace every "change-me" value
#   ./scripts/generate-secrets.sh > .env   generates a ready-to-use .env with random secrets
#
# NEVER commit .env. Every secret below is required (compose fails fast when missing).
###############################################################################

# ---------------------------------------------------------------- general
APP_ENV=development
LOG_LEVEL=INFO
# comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=aivms
POSTGRES_USER=aivms
POSTGRES_PASSWORD=change-me-postgres

# ---------------------------------------------------------------- Redis
REDIS_PASSWORD=change-me-redis

# ---------------------------------------------------------------- Auth
# openssl rand -hex 32
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key used to encrypt RTSP passwords at rest
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me-fernet-key

# First admin account (created only if no admin exists)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin
INITIAL_ADMIN_EMAIL=

# ---------------------------------------------------------------- Edge provisioning
# shared secret edge agents present once to self-register and obtain their own device key
EDGE_PROVISIONING_TOKEN=change-me-provisioning-token

# ---------------------------------------------------------------- MQTT (Mosquitto / EMQX)
MQTT_BACKEND_USERNAME=backend
MQTT_BACKEND_PASSWORD=change-me-mqtt-backend
MQTT_EDGE_USERNAME=edge
MQTT_EDGE_PASSWORD=change-me-mqtt-edge
# shared-subscription group; all backend replicas in the same group split the load
MQTT_SHARED_GROUP=backend
# broker address that REMOTE edge devices use (returned by /api/v1/edge/config)
MQTT_PUBLIC_HOST=localhost

# ---------------------------------------------------------------- MinIO
MINIO_ROOT_USER=aivms-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_SNAPSHOTS=snapshots
# URL browsers use to download snapshots (presigned GET)
MINIO_PUBLIC_URL=http://localhost:9000
# URL edge agents use to upload snapshots (presigned PUT). The demo edge runs inside compose.
# For remote edge devices use an address they can reach, e.g. http://<server-ip>:9000
MINIO_EDGE_URL=http://minio:9000
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# ---------------------------------------------------------------- MediaMTX
# URLs the BROWSER uses for playback
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
MEDIAMTX_HLS_PUBLIC_URL=http://localhost:8888
# Addresses REMOTE edge devices push the annotated stream to (outgoing from the edge; NAT friendly)
MEDIAMTX_RTSP_PUBLISH_URL=rtsp://localhost:8554
MEDIAMTX_SRT_PUBLISH_URL=srt://localhost:8890
# default push protocol handed to edge agents: rtsp (LAN / VPN) | srt (across the Internet)
EDGE_STREAM_PROTOCOL=rtsp
# public IP(s)/hostname(s) for WebRTC ICE candidates (comma separated), needed when not on localhost
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=

# ---------------------------------------------------------------- Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------- Demo edge agent (profile "edge")
SEED_DEMO_DATA=true
EDGE_DEVICE_UUID=edge01
EDGE_DEVICE_NAME="Demo Edge"
EDGE_DETECTOR=mock
# auto = h264_nvenc when an NVIDIA GPU is available, otherwise libx264
EDGE_VIDEO_ENCODER=auto

# ---------------------------------------------------------------- Published ports (optional)
# BACKEND_PORT_PUBLISHED=8000
# FRONTEND_PORT_PUBLISHED=3000
# MQTT_PORT_PUBLISHED=1883
# POSTGRES_PORT_PUBLISHED=127.0.0.1:5432
# REDIS_PORT_PUBLISHED=127.0.0.1:6379
