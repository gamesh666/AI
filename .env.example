###############################################################################
# AIBOX SERVER — environment variables
#
#   ./scripts/install.sh                     creates .env from this file with random secrets
#   ./scripts/generate-secrets.sh > .env     (only the .env, without installing)
#
# NEVER commit .env. Every secret below is required (compose fails fast when missing).
###############################################################################

# ---------------------------------------------------------------- general
APP_ENV=production
LOG_LEVEL=INFO
# browser origins allowed to call the API (set by ./scripts/set-public-host.sh)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_DB=aivms
POSTGRES_USER=aivms
POSTGRES_PASSWORD=change-me-postgres

# ---------------------------------------------------------------- Redis
REDIS_PASSWORD=change-me-redis

# ---------------------------------------------------------------- Auth
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Fernet key that encrypts stored camera passwords
CREDENTIAL_ENCRYPTION_KEY=change-me-fernet-key

# First admin account (created only if no admin exists; change the password after the first login)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin
INITIAL_ADMIN_EMAIL=

# ---------------------------------------------------------------- MinIO (snapshots)
MINIO_ROOT_USER=aivms-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET_SNAPSHOTS=snapshots
# address browsers download snapshots from / edge devices upload them to
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_EDGE_URL=http://localhost:9000
# MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z

# ---------------------------------------------------------------- MediaMTX (live video)
# addresses browsers play from
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
MEDIAMTX_HLS_PUBLIC_URL=http://localhost:8888
# addresses edge devices push the annotated video to
MEDIAMTX_RTSP_PUBLISH_URL=rtsp://localhost:8554
MEDIAMTX_SRT_PUBLISH_URL=srt://localhost:8890
# push protocol handed to edges: rtsp (LAN / VPN) | srt (across the Internet)
EDGE_STREAM_PROTOCOL=rtsp
# this server's IP / hostname for WebRTC (comma separated)
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=

# ---------------------------------------------------------------- Web UI (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
# sign out after this many minutes without activity (0 = never)
IDLE_LOGOUT_MINUTES=10

# ---------------------------------------------------------------- Published ports (optional)
# BACKEND_PORT_PUBLISHED=8000
# FRONTEND_PORT_PUBLISHED=3000
# POSTGRES_PORT_PUBLISHED=127.0.0.1:5432
# REDIS_PORT_PUBLISHED=127.0.0.1:6379
