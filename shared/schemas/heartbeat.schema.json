{
  "$defs": {
    "ReportedModel": {
      "description": "A model the edge is running right now (whatever runtime it uses). Shown on the platform as-is.",
      "properties": {
        "name": {
          "description": "e.g. yolo11n, ppe-detector",
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "type": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. yolov8, yolo11, onnx, tensorrt",
          "title": "Type"
        },
        "task": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "what it recognises, e.g. person / cell phone",
          "title": "Task"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Labels",
          "type": "array"
        },
        "cameras": {
          "description": "camera codes using this model",
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "title": "Cameras",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ReportedModel",
      "type": "object"
    }
  },
  "properties": {
    "device_uuid": {
      "title": "Device Uuid",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "cpu_usage": {
      "maximum": 100,
      "minimum": 0,
      "title": "Cpu Usage",
      "type": "number"
    },
    "memory_usage": {
      "maximum": 100,
      "minimum": 0,
      "title": "Memory Usage",
      "type": "number"
    },
    "gpu_usage": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpu Usage"
    },
    "gpu_memory_usage": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpu Memory Usage"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "agent_version": {
      "title": "Agent Version",
      "type": "string"
    },
    "hostname": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hostname"
    },
    "ip_address": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ip Address"
    },
    "gpu_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gpu Name"
    },
    "gpu_memory": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Total GPU memory in MB",
      "title": "Gpu Memory"
    },
    "models": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ReportedModel"
          },
          "maxItems": 50,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Models"
    }
  },
  "required": [
    "device_uuid",
    "cpu_usage",
    "memory_usage",
    "agent_version"
  ],
  "title": "Heartbeat",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
